#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_UniformBlock
{
    float4 Color;
};

struct type_LightingBlock
{
    packed_float3 LightDirection;
    float Pad1;
    packed_float3 LightColor;
    float Pad2;
    float3 AmbientColor;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_UniformBlock& UniformBlock [[buffer(0)]], constant type_LightingBlock& LightingBlock [[buffer(1)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = float4(UniformBlock.Color.xyz * (LightingBlock.AmbientColor + (float3(LightingBlock.LightColor) * precise::max(0.0, dot(in.in_var_TEXCOORD0, float3(LightingBlock.LightDirection))))), 1.0);
    return out;
}

