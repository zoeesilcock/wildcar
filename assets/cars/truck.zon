// Car measurements:
// Model scale: 16x2 (1 blockbench unit = 0.125 game units).
//
// Wheel positions:
// * X: 1.3/-1.2
// * Z: 1/-1
.{
    .mass = 1000,
    .engine_power = 75,
    .max_acceleration = 8,
    .max_braking_deceleration = 10,
    .wheel_radius = 0.5,
    .drive_wheels = .{ 1, 3 },
    .steer_wheels = .{ 0, 2 },
    .max_steering_angle = 0.5,
    .lateral_stiffness = 1000,
    .friction_coefficient = 1.0,
    .suspension_max_extension = 0.2,
    .suspension_max_compression = 0.2,
    .suspension_stiffness = 50000,
    .suspension_damping_ratio = 0.3,
    .suspension_bump_stop_start = 0.18,
    .suspension_bump_stop_stiffness = 300000,
    .suspension_bump_stop_damping_ratio = 0.05,
}
